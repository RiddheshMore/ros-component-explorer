    classDef queryStyle fill:#e3f2fd,stroke:#1565c0,stroke-width:3px
    classDef vectorStyle fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px
    classDef mathStyle fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef scoreStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    classDef resultStyle fill:#fce4ec,stroke:#c2185b,stroke-width:2px
    classDef detailStyle fill:#fff9c4,stroke:#f57f17,stroke-width:1px,stroke-dasharray: 5 5
    
    class Query,QueryVec queryStyle
    class Step1,Step2,Components vectorStyle
    class Step3,Formula,Step4 mathStyle
