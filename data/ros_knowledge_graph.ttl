<http://www.ros.org/ontology#package/teb-local-planner> a ros:ControlPackage,
        ros:NavigationPackage,
        ros:ROSPackage ;
    rdfs:label "Teb Local Planner"^^xsd:string ;
    dcterms:description """
    The teb_local_planner package implements a plugin
    to the base_local_planner of the 2D navigation stack.
    The underlying method called Timed Elastic Band locally optimizes
    the robot's trajectory with respect to trajectory execution time,
    separation from obstacles and compliance with kinodynamic constraints at runtime.	
  """^^xsd:string,
        "Use case: Car‑like robot planning with kinodynamic constraints"^^xsd:string,
        "Use case: Real‑time local path planning and obstacle avoidance for mobile robots"^^xsd:string,
        "Use case: Trajectory optimization for autonomous navigation in simulation or on real hardware"^^xsd:string ;
    ros:buildDependsOn <http://www.ros.org/ontology#package/base-local-planner>,
        <http://www.ros.org/ontology#package/cmake-modules>,
        <http://www.ros.org/ontology#package/costmap-2d>,
        <http://www.ros.org/ontology#package/costmap-converter>,
        <http://www.ros.org/ontology#package/dynamic-reconfigure>,
        <http://www.ros.org/ontology#package/geometry-msgs>,
        <http://www.ros.org/ontology#package/interactive-markers>,
        <http://www.ros.org/ontology#package/libg2o>,
        <http://www.ros.org/ontology#package/mbf-costmap-core>,
        <http://www.ros.org/ontology#package/mbf-msgs>,
        <http://www.ros.org/ontology#package/message-generation>,
        <http://www.ros.org/ontology#package/nav-core>,
        <http://www.ros.org/ontology#package/nav-msgs>,
        <http://www.ros.org/ontology#package/pluginlib>,
        <http://www.ros.org/ontology#package/roscpp>,
        <http://www.ros.org/ontology#package/std-msgs>,
        <http://www.ros.org/ontology#package/tf2>,
        <http://www.ros.org/ontology#package/tf2-eigen>,
        <http://www.ros.org/ontology#package/tf2-geometry-msgs>,
        <http://www.ros.org/ontology#package/tf2-ros>,
        <http://www.ros.org/ontology#package/visualization-msgs> ;
    ros:distribution "humble"^^xsd:string ;
    ros:implementsAlgorithm "Timed Elastic Band"^^xsd:string,
        "kinodynamic trajectory optimization"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD"^^xsd:string ;
    ros:maintainer "Christoph Rösmann <christoph.roesmann@tu-dortmund.de>"^^xsd:string ;
    ros:packageName "teb_local_planner"^^xsd:string ;
    ros:packageVersion "0.9.1"^^xsd:string ;
    ros:primaryFunction "Optimizes 2D robot trajectories in real-time using the Timed Elastic Band method, providing a plugin for the ROS 2D navigation stack's base_local_planner."^^xsd:string ;
    ros:repositoryURL "https://github.com/rst-tu-dortmund/teb_local_planner"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/base-local-planner>,
        <http://www.ros.org/ontology#package/costmap-2d>,
        <http://www.ros.org/ontology#package/costmap-converter>,
        <http://www.ros.org/ontology#package/dynamic-reconfigure>,
        <http://www.ros.org/ontology#package/geometry-msgs>,
