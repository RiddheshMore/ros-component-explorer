        <http://www.ros.org/ontology#package/ament-lint-common>,
        <http://www.ros.org/ontology#package/rosidl-cmake> ;
    ros:packageName "sensor_msgs"^^xsd:string ;
    ros:packageVersion "5.9.1"^^xsd:string ;
    ros:primaryFunction "Provide standardized message and service definitions for sensor data to enable inter-stack communication in ROS."^^xsd:string ;
    ros:repositoryURL "https://github.com/ros2/common_interfaces"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/builtin-interfaces>,
