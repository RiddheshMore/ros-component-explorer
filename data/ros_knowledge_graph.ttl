    ros:packageName "control_msgs"^^xsd:string ;
    ros:packageVersion "6.5.0"^^xsd:string ;
    ros:primaryFunction "Provide base messages and actions for robot control, including representations of controller setpoints and joint and Cartesian trajectories."^^xsd:string ;
    ros:repositoryURL "https://github.com/ros-controls/control_msgs"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/action-msgs>,
        <http://www.ros.org/ontology#package/builtin-interfaces>,
        <http://www.ros.org/ontology#package/diagnostic-msgs>,
        <http://www.ros.org/ontology#package/geometry-msgs>,
        <http://www.ros.org/ontology#package/rosidl-default-runtime>,
        <http://www.ros.org/ontology#package/sensor-msgs>,
        <http://www.ros.org/ontology#package/std-msgs>,
        <http://www.ros.org/ontology#package/trajectory-msgs> ;
    rdfs:comment """Package: control_msgs | Description: 
    control_msgs contains base messages and actions useful for
    controlling robots. It provides representations for controller
    setpoints and joint and cartesian trajectories.
   | Function: Provide base messages and actions for robot control, including representations of controller setpoints and joint and Cartesian trajectories. | Use Cases: Sending joint trajectory setpoints to robot controllers, Sending Cartesian trajectory setpoints, Facilitating communication between high‑level planners and low‑level controllers | Categories: control"""^^xsd:string .

