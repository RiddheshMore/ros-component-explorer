<http://www.ros.org/ontology#package/ackermann-steering-controller> a ros:ControlPackage,
        ros:ROSPackage ;
    rdfs:label "Ackermann Steering Controller"^^xsd:string ;
    dcterms:description "Steering controller for Ackermann kinematics. Rear fixed wheels are powering the vehicle and front wheels are steering it."^^xsd:string,
        "Use case: Autonomous ground vehicle navigation"^^xsd:string,
        "Use case: Robot car steering control"^^xsd:string,
        "Use case: Simulation of Ackermann-steered vehicles"^^xsd:string ;
    ros:buildDependsOn <http://www.ros.org/ontology#package/backward-ros>,
