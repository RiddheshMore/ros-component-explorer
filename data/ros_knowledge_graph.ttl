        <http://www.ros.org/ontology#package/python3-pytest>,
        <http://www.ros.org/ontology#package/rclcpp-lifecycle> ;
    ros:packageName "diagnostic_updater"^^xsd:string ;
    ros:packageVersion "4.4.6"^^xsd:string ;
    ros:primaryFunction "Provide base classes for publishing custom diagnostic messages to the /diagnostics topic, enabling device drivers and system components to report status and health information."^^xsd:string ;
    ros:repositoryURL "https://github.com/ros/diagnostics"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/diagnostic-msgs>,
        <http://www.ros.org/ontology#package/rclcpp>,
        <http://www.ros.org/ontology#package/rclpy>,
        <http://www.ros.org/ontology#package/std-msgs> ;
    rdfs:comment "Package: diagnostic_updater | Description: diagnostic_updater contains tools for easily updating diagnostics. it is commonly used in device drivers to keep track of the status of output topics, device status, etc. | Function: Provide base classes for publishing custom diagnostic messages to the /diagnostics topic, enabling device drivers and system components to report status and health information. | Use Cases: Integrating diagnostic reporting into device drivers, Monitoring status of output topics and device health, Enabling diagnostics aggregation by diagnostic_aggregator, Facilitating visualization via rqt_robot_monitor or rqt_runtime_monitor | Categories: diagnostics"^^xsd:string .

<http://www.ros.org/ontology#package/image-transport> a ros:PerceptionPackage,
        ros:ROSPackage ;
    rdfs:label "Image Transport"^^xsd:string ;
    dcterms:description """

     image_transport should always be used to subscribe to and publish images. It provides transparent
     support for transporting images in low-bandwidth compressed formats. Examples (provided by separate
     plugin packages) include JPEG/PNG compression and Theora streaming video.

  """^^xsd:string,
        "Use case: Integrating with Python via image_transport_py for rapid prototyping"^^xsd:string,
        "Use case: Publishing image streams from cameras to downstream processing nodes"^^xsd:string,
        "Use case: Subscribing to image streams for computer vision tasks"^^xsd:string,
        "Use case: Using compressed or raw transports to reduce bandwidth usage"^^xsd:string ;
    ros:buildDependsOn <http://www.ros.org/ontology#package/message-filters>,
        <http://www.ros.org/ontology#package/pluginlib>,
        <http://www.ros.org/ontology#package/rclcpp>,
        <http://www.ros.org/ontology#package/rclcpp-components>,
        <http://www.ros.org/ontology#package/sensor-msgs> ;
    ros:distribution "humble"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD"^^xsd:string ;
    ros:maintainer "Alejandro Hernandez Cordero <alejandro@openrobotics.org>"^^xsd:string,
        "Geoffrey Biggs <geoff@openrobotics.org>"^^xsd:string ;
    ros:optionallyDependsOn <http://www.ros.org/ontology#package/ament-cmake-gtest>,
        <http://www.ros.org/ontology#package/ament-lint-auto>,
        <http://www.ros.org/ontology#package/ament-lint-common>,
        <http://www.ros.org/ontology#package/rclcpp-lifecycle> ;
    ros:packageName "image_transport"^^xsd:string ;
    ros:packageVersion "6.4.2"^^xsd:string ;
    ros:primaryFunction "Efficient publishing and subscribing of image topics using various transport plugins such as raw, compressed, JPEG/PNG, and Theora, providing low‑bandwidth support and reduced overhead."^^xsd:string ;
    ros:repositoryURL "https://github.com/ros-perception/image_common"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/message-filters>,
        <http://www.ros.org/ontology#package/pluginlib>,
        <http://www.ros.org/ontology#package/rclcpp>,
        <http://www.ros.org/ontology#package/rclcpp-components>,
        <http://www.ros.org/ontology#package/sensor-msgs> ;
    rdfs:comment """Package: image_transport | Description: 

     image_transport should always be used to subscribe to and publish images. It provides transparent
     support for transporting images in low-bandwidth compressed formats. Examples (provided by separate
     plugin packages) include JPEG/PNG compression and Theora streaming video.

   | Function: Efficient publishing and subscribing of image topics using various transport plugins such as raw, compressed, JPEG/PNG, and Theora, providing low‑bandwidth support and reduced overhead. | Use Cases: Publishing image streams from cameras to downstream processing nodes, Subscribing to image streams for computer vision tasks, Using compressed or raw transports to reduce bandwidth usage, Integrating with Python via image_transport_py for rapid prototyping | Performance: Provides low‑bandwidth compressed image transport, reducing bandwidth and overhead compared to raw topics. | Categories: perception"""^^xsd:string,
        "Performance: Provides low‑bandwidth compressed image transport, reducing bandwidth and overhead compared to raw topics."^^xsd:string .

<http://www.ros.org/ontology#package/angles> a ros:ROSPackage ;
    rdfs:label "Angles"^^xsd:string ;
    dcterms:description """This package provides a set of simple math utilities to work
        with angles. The utilities cover simple things like
        normalizing an angle and conversion between degrees and
        radians. But even if you're trying to calculate things like
        the shortest angular distance between two joint space
        positions of your robot, but the joint motion is constrained
        by joint limits, this package is what you need. The code in
        this package is stable and well tested. There are no plans for
        major changes in the near future."""^^xsd:string,
        "Use case: Calculating the shortest angular distance between joint space positions while respecting joint limits"^^xsd:string,
        "Use case: Converting angles between degrees and radians in configuration or logging"^^xsd:string,
        "Use case: Normalizing angles in robot control loops"^^xsd:string,
        "Use case: Providing robust angle math for motion planning and kinematics"^^xsd:string ;
    ros:distribution "humble"^^xsd:string ;
    ros:implementsAlgorithm "angle normalization"^^xsd:string,
        "degree-radian conversion"^^xsd:string,
        "shortest angular distance calculation"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD"^^xsd:string ;
    ros:maintainer "David V. Lu!! <davidvlu@gmail.com>"^^xsd:string,
        "Tully Foote <tfoote@osrfoundation.org>"^^xsd:string ;
    ros:optionallyDependsOn <http://www.ros.org/ontology#package/ament-cmake-gtest>,
        <http://www.ros.org/ontology#package/ament-cmake-pytest> ;
    ros:packageName "angles"^^xsd:string ;
    ros:packageVersion "1.16.1"^^xsd:string ;
    ros:primaryFunction "Provide simple math utilities for working with angles, including normalization, conversion between degrees and radians, and computing the shortest angular distance between joint space positions while respecting joint limits."^^xsd:string ;
    ros:repositoryURL "https://github.com/ros/angles"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    rdfs:comment """Package: angles | Description: This package provides a set of simple math utilities to work
        with angles. The utilities cover simple things like
        normalizing an angle and conversion between degrees and
        radians. But even if you're trying to calculate things like
        the shortest angular distance between two joint space
        positions of your robot, but the joint motion is constrained
        by joint limits, this package is what you need. The code in
        this package is stable and well tested. There are no plans for
        major changes in the near future. | Function: Provide simple math utilities for working with angles, including normalization, conversion between degrees and radians, and computing the shortest angular distance between joint space positions while respecting joint limits. | Use Cases: Calculating the shortest angular distance between joint space positions while respecting joint limits, Normalizing angles in robot control loops, Converting angles between degrees and radians in configuration or logging, Providing robust angle math for motion planning and kinematics | Algorithms: angle normalization, degree-radian conversion, shortest angular distance calculation"""^^xsd:string .

<http://www.ros.org/ontology#package/control-msgs> a ros:ControlPackage,
        ros:ROSPackage ;
