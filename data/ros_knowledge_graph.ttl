<http://www.ros.org/ontology#package/tf2> a ros:NavigationPackage,
        ros:PerceptionPackage,
        ros:ROSPackage ;
    rdfs:label "Tf2"^^xsd:string ;
    dcterms:description """
    tf2 is the second generation of the transform library, which lets
    the user keep track of multiple coordinate frames over time. tf2
    maintains the relationship between coordinate frames in a tree
    structure buffered in time, and lets the user transform points,
    vectors, etc between any two coordinate frames at any desired
    point in time.
  """^^xsd:string,
        "Use case: Broadcasting dynamic transforms for moving parts such as wheels"^^xsd:string,
        "Use case: Broadcasting static transforms from sensors or fixed frames"^^xsd:string,
        "Use case: Dumping and inspecting all known frames"^^xsd:string,
        "Use case: Listening for and waiting on transforms in applications"^^xsd:string,
        "Use case: Using coroutines to asynchronously wait for transforms"^^xsd:string ;
    ros:buildDependsOn <http://www.ros.org/ontology#package/builtin-interfaces>,
        <http://www.ros.org/ontology#package/geometry-msgs>,
        <http://www.ros.org/ontology#package/rcutils>,
        <http://www.ros.org/ontology#package/rosidl-runtime-cpp> ;
    ros:distribution "humble"^^xsd:string ;
    ros:implementsAlgorithm "frame buffering"^^xsd:string,
        "transform interpolation"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD"^^xsd:string ;
    ros:maintainer "Alejandro Hernandez Cordero <alejandro@openrobotics.org>"^^xsd:string,
        "Chris Lalancette <clalancette@openrobotics.org>"^^xsd:string ;
    ros:optionallyDependsOn <http://www.ros.org/ontology#package/ament-cmake-copyright>,
        <http://www.ros.org/ontology#package/ament-cmake-cppcheck>,
        <http://www.ros.org/ontology#package/ament-cmake-cpplint>,
        <http://www.ros.org/ontology#package/ament-cmake-google-benchmark>,
        <http://www.ros.org/ontology#package/ament-cmake-gtest>,
        <http://www.ros.org/ontology#package/ament-cmake-lint-cmake>,
        <http://www.ros.org/ontology#package/ament-cmake-uncrustify>,
        <http://www.ros.org/ontology#package/ament-cmake-xmllint> ;
    ros:packageName "tf2"^^xsd:string ;
    ros:packageVersion "0.45.2"^^xsd:string ;
    ros:primaryFunction "Provides a library for managing and transforming coordinate frames over time, enabling broadcasting and lookup of transforms between frames in ROS 2."^^xsd:string ;
    ros:repositoryURL "https://github.com/ros2/geometry2"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/builtin-interfaces>,
        <http://www.ros.org/ontology#package/geometry-msgs>,
        <http://www.ros.org/ontology#package/rcutils> ;
    rdfs:comment """Package: tf2 | Description: 
    tf2 is the second generation of the transform library, which lets
    the user keep track of multiple coordinate frames over time. tf2
    maintains the relationship between coordinate frames in a tree
    structure buffered in time, and lets the user transform points,
    vectors, etc between any two coordinate frames at any desired
    point in time.
   | Function: Provides a library for managing and transforming coordinate frames over time, enabling broadcasting and lookup of transforms between frames in ROS 2. | Use Cases: Broadcasting static transforms from sensors or fixed frames, Broadcasting dynamic transforms for moving parts such as wheels, Listening for and waiting on transforms in applications, Using coroutines to asynchronously wait for transforms, Dumping and inspecting all known frames | Algorithms: transform interpolation, frame buffering | Categories: perception, navigation"""^^xsd:string .

<http://www.ros.org/ontology#package/sensor-msgs> a ros:PerceptionPackage,
        ros:ROSPackage,
        ros:SensorPackage ;
    rdfs:label "Sensor Msgs"^^xsd:string ;
    dcterms:description "A package containing some sensor data related message and service definitions."^^xsd:string,
        "Use case: Facilitating communication between independent ROS packages without circular dependencies."^^xsd:string,
        "Use case: Publishing sensor data (e.g., images, laser scans, IMU readings) from hardware nodes."^^xsd:string,
        "Use case: Subscribing to sensor data in perception, navigation, or other processing nodes."^^xsd:string ;
    ros:buildDependsOn <http://www.ros.org/ontology#package/builtin-interfaces>,
        <http://www.ros.org/ontology#package/geometry-msgs>,
        <http://www.ros.org/ontology#package/std-msgs> ;
    ros:distribution "humble"^^xsd:string ;
