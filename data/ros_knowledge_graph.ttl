<http://www.ros.org/ontology#package/ess-imu-driver2> a ros:PerceptionPackage,
        ros:ROSPackage ;
    rdfs:label "Ess Imu Ros2 Uart Driver"^^xsd:string ;
    dcterms:description "ROS2 package for Epson IMU using UART interface based on C++ wrapper of Linux C driver"^^xsd:string,
        "Use case: Integrate Epson IMU inertial data into ROS2 applications such as localization, mapping, or navigation stacks."^^xsd:string,
        "Use case: Publish raw IMU data to ROS topics for downstream sensor fusion (e.g., EKF, SLAM) or control modules."^^xsd:string,
        "Use case: Test and evaluate Epson IMU performance on ROS2 with various operating systems and hardware interfaces."^^xsd:string,
        "Use case: Use the node on embedded Linux robots where GPIO control of IMU reset or interrupts is desired."^^xsd:string ;
    ros:buildDependsOn <http://www.ros.org/ontology#package/rclcpp>,
        <http://www.ros.org/ontology#package/sensor-msgs>,
        <http://www.ros.org/ontology#package/std-msgs> ;
    ros:distribution "humble"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD-3"^^xsd:string,
        "Public Domain"^^xsd:string ;
    ros:maintainer "Raymond Chow <raymond.chow@ea.epson.com>"^^xsd:string ;
    ros:packageName "ess_imu_ros2_uart_driver"^^xsd:string ;
    ros:packageVersion "1.2.0"^^xsd:string ;
    ros:primaryFunction "Provide a ROS2 node that interfaces with Epson IMU devices over UART, publishing IMU data (orientation, acceleration, gyro) to ROS topics."^^xsd:string ;
    ros:repositoryURL "https://github.com/cubicleguy/ess_imu_ros2_uart_driver"^^xsd:anyURI ;
    ros:requiresHardware hw:IMU ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/rclcpp>,
        <http://www.ros.org/ontology#package/sensor-msgs>,
        <http://www.ros.org/ontology#package/std-msgs> ;
    ros:supportsHardware hw:IMU ;
    rdfs:comment "Package: ess_imu_driver2 | Description: ROS2 package for Epson IMU using UART interface based on C++ wrapper of Linux C driver | Function: Provide a ROS2 node that interfaces with Epson IMU devices over UART, publishing IMU data (orientation, acceleration, gyro) to ROS topics. | Use Cases: Integrate Epson IMU inertial data into ROS2 applications such as localization, mapping, or navigation stacks., Publish raw IMU data to ROS topics for downstream sensor fusion (e.g., EKF, SLAM) or control modules., Use the node on embedded Linux robots where GPIO control of IMU reset or interrupts is desired., Test and evaluate Epson IMU performance on ROS2 with various operating systems and hardware interfaces. | Hardware Required: Epson IMU (model G320, G330, G354, G364, G365, G366, G370, V340), USB‑Serial interface (e.g., Epson USB evaluation board, FTDI USB‑to‑UART bridge), UART connection (direct or via USB‑UART bridge), ROS2‑compatible host (Ubuntu 18.04 LTS or 20.04 LTS, ROS2 Dashing/Eloquent/Foxy), Optional GPIO pins for RESET#, DRDY, EXT (for embedded Linux platforms) | Hardware Supported: Epson IMU (G320/G330/G354/G364/G365/G366/G370/V340), USB‑Serial interfaces (FTDI, Epson evaluation board), UART ports, Linux‑based embedded platforms (e.g., Raspberry Pi) with GPIO support | Performance: When connected through USB‑UART bridges, the driver may exhibit high latency or lower-than-expected IMU data rates. Users can reduce latency by adjusting the device’s `latency_timer` via the sysfs interface and enabling the `low_latency` flag with the `setserial` utility. | Categories: perception"^^xsd:string,
        "Performance: When connected through USB‑UART bridges, the driver may exhibit high latency or lower-than-expected IMU data rates. Users can reduce latency by adjusting the device’s `latency_timer` via the sysfs interface and enabling the `low_latency` flag with the `setserial` utility."^^xsd:string .

