<http://www.ros.org/ontology#package/andino-control> a ros:ControlPackage,
        ros:ROSPackage ;
    rdfs:label "Andino Control"^^xsd:string ;
    dcterms:description "The andino_control package"^^xsd:string,
        "Use case: Navigation stack integration with Nav2"^^xsd:string,
        "Use case: Robot base bringup"^^xsd:string,
        "Use case: Simulation launch in Gazebo"^^xsd:string,
        "Use case: Teleoperation with joystick or keyboard"^^xsd:string ;
    ros:distribution "humble"^^xsd:string ;
    ros:implementsAlgorithm "Differential drive control"^^xsd:string,
        "Joint state broadcasting"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD Clause 3"^^xsd:string ;
    ros:maintainer "Franco Cipollone <franco.c@ekumenlabs.com>"^^xsd:string ;
    ros:optionallyDependsOn <http://www.ros.org/ontology#package/ament-cmake-clang-format> ;
    ros:packageName "andino_control"^^xsd:string ;
    ros:packageVersion "0.2.0"^^xsd:string ;
    ros:primaryFunction "Launches the ROS 2 controller manager and diff_drive_controller for the Andino differential drive robot, providing base motion control and joint state broadcasting."^^xsd:string ;
    ros:repositoryURL "https://github.com/Ekumen-OS/andino"^^xsd:anyURI ;
    ros:requiresHardware hw:WheelEncoder ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/andino-base>,
        <http://www.ros.org/ontology#package/andino-description>,
        <http://www.ros.org/ontology#package/controller-manager>,
        <http://www.ros.org/ontology#package/diff-drive-controller>,
        <http://www.ros.org/ontology#package/joint-state-broadcaster>,
        <http://www.ros.org/ontology#package/ros2controlcli> ;
    rdfs:comment "Package: andino_control | Description: The andino_control package | Function: Launches the ROS 2 controller manager and diff_drive_controller for the Andino differential drive robot, providing base motion control and joint state broadcasting. | Use Cases: Robot base bringup, Teleoperation with joystick or keyboard, Navigation stack integration with Nav2, Simulation launch in Gazebo | Algorithms: Differential drive control, Joint state broadcasting | Hardware Required: Drive motors with encoder feedback, Wheel encoders | Hardware Supported: Andino diff drive robot, Any ROS 2 control compliant diff drive platform | Categories: control"^^xsd:string .

<http://www.ros.org/ontology#package/andino-navigation> a ros:NavigationPackage,
        ros:ROSPackage ;
    rdfs:label "Andino Navigation"^^xsd:string ;
    dcterms:description """
    Bring up nav2 package with Andino.
  """^^xsd:string,
        "Use case: Autonomous indoor navigation of the Andino robot"^^xsd:string,
        "Use case: Integration with ROS 2 launch system for robot bring‑up and navigation"^^xsd:string,
        "Use case: Teleoperation via keyboard or joystick with integrated navigation"^^xsd:string ;
    ros:buildDependsOn <http://www.ros.org/ontology#package/launch-ros> ;
    ros:distribution "humble"^^xsd:string ;
    ros:implementsAlgorithm "nav2"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD Clause 3"^^xsd:string ;
    ros:maintainer "Franco Cipollone <franco.c@ekumenlabs.com>"^^xsd:string,
        "Olmer Garcia <olmerg@ekumenlabs.com>"^^xsd:string ;
    ros:optionallyDependsOn <http://www.ros.org/ontology#package/ament-lint-auto>,
        <http://www.ros.org/ontology#package/ament-lint-common> ;
    ros:packageName "andino_navigation"^^xsd:string ;
    ros:packageVersion "0.2.0"^^xsd:string ;
    ros:primaryFunction "Navigation stack based on ROS 2 Nav2 for autonomous navigation of the Andino robot"^^xsd:string ;
    ros:repositoryURL "https://github.com/Ekumen-OS/andino"^^xsd:anyURI ;
    ros:requiresHardware hw:Camera,
        hw:LaserScanner ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/launch-ros>,
        <http://www.ros.org/ontology#package/nav2-bringup>,
        <http://www.ros.org/ontology#package/navigation2>,
        <http://www.ros.org/ontology#package/rviz2> ;
    ros:supportsHardware hw:Camera,
        hw:LaserScanner ;
    rdfs:comment """Package: andino_navigation | Description: 
    Bring up nav2 package with Andino.
   | Function: Navigation stack based on ROS 2 Nav2 for autonomous navigation of the Andino robot | Use Cases: Autonomous indoor navigation of the Andino robot, Teleoperation via keyboard or joystick with integrated navigation, Integration with ROS 2 launch system for robot bring‑up and navigation | Algorithms: nav2 | Hardware Required: RPLIDAR laser scanner, camera, differential drive base | Hardware Supported: RPLIDAR laser scanner, camera, differential drive base | Categories: navigation"""^^xsd:string .

<http://www.ros.org/ontology#package/andino-slam> a ros:LocalizationPackage,
