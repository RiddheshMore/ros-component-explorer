<http://www.ros.org/ontology#package/imu-complementary-filter> a ros:LocalizationPackage,
        ros:PerceptionPackage,
        ros:ROSPackage ;
    rdfs:label "Imu Complementary Filter"^^xsd:string ;
    dcterms:description "Filter which fuses angular velocities, accelerations, and (optionally) magnetic readings from a generic IMU device into a quaternion to represent the orientation of the device wrt the global frame. Based on the algorithm by Roberto G. Valenti etal. described in the paper \"Keeping a Good Attitude: A Quaternion-Based Orientation Filter for IMUs and MARGs\" available at http://www.mdpi.com/1424-8220/15/8/19302 ."^^xsd:string,
        "Use case: Drone attitude estimation"^^xsd:string,
        "Use case: Mobile robot pose estimation in SLAM pipelines"^^xsd:string,
        "Use case: Robotic platform orientation estimation"^^xsd:string,
        "Use case: Virtual reality head‑tracking"^^xsd:string ;
    ros:buildDependsOn <http://www.ros.org/ontology#package/geometry-msgs>,
        <http://www.ros.org/ontology#package/message-filters>,
        <http://www.ros.org/ontology#package/rclcpp>,
        <http://www.ros.org/ontology#package/sensor-msgs>,
        <http://www.ros.org/ontology#package/std-msgs>,
        <http://www.ros.org/ontology#package/tf2>,
        <http://www.ros.org/ontology#package/tf2-ros> ;
    ros:distribution "humble"^^xsd:string ;
    ros:implementsAlgorithm "Complementary fusion based on Valenti et al. quaternion-based orientation filter"^^xsd:string,
        "Quaternion-based IMU attitude estimation"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD"^^xsd:string ;
    ros:maintainer "Martin Günther <martin.guenther@dfki.de>"^^xsd:string ;
    ros:packageName "imu_complementary_filter"^^xsd:string ;
    ros:packageVersion "2.2.1"^^xsd:string ;
    ros:primaryFunction "A filter that fuses angular velocities, linear accelerations, and optionally magnetometer readings from a generic IMU to produce an orientation quaternion representing the device's pose relative to the global frame."^^xsd:string ;
    ros:repositoryURL "https://github.com/CCNYRoboticsLab/imu_tools"^^xsd:anyURI ;
    ros:requiresHardware hw:IMU ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:supportsHardware hw:IMU ;
    rdfs:comment "Package: imu_complementary_filter | Description: Filter which fuses angular velocities, accelerations, and (optionally) magnetic readings from a generic IMU device into a quaternion to represent the orientation of the device wrt the global frame. Based on the algorithm by Roberto G. Valenti etal. described in the paper \"Keeping a Good Attitude: A Quaternion-Based Orientation Filter for IMUs and MARGs\" available at http://www.mdpi.com/1424-8220/15/8/19302 . | Function: A filter that fuses angular velocities, linear accelerations, and optionally magnetometer readings from a generic IMU to produce an orientation quaternion representing the device's pose relative to the global frame. | Use Cases: Robotic platform orientation estimation, Drone attitude estimation, Virtual reality head‑tracking, Mobile robot pose estimation in SLAM pipelines | Algorithms: Complementary fusion based on Valenti et al. quaternion-based orientation filter, Quaternion-based IMU attitude estimation | Hardware Required: Inertial Measurement Unit (IMU) providing angular velocity, linear acceleration, and optionally magnetic field readings | Hardware Supported: Generic IMU devices with gyro, accelerometer, and optional magnetometer sensors | Categories: perception, localization"^^xsd:string .

<http://www.ros.org/ontology#package/joint-state-publisher> a ros:ControlPackage,
        ros:ROSPackage ;
    rdfs:label "Joint State Publisher"^^xsd:string ;
    dcterms:description """
    This package contains a tool for setting and publishing joint state values for a given URDF.
  """^^xsd:string,
        "Use case: Handle mimic joint relationships and safety limits defined in the URDF without additional hardware"^^xsd:string,
        "Use case: Provide /joint_states to robot_state_publisher in both simulation and real‑robot contexts to ensure valid transforms for all movable joints"^^xsd:string,
        "Use case: Simulate joint states for a URDF robot during development or testing when actual joint sensors are not available"^^xsd:string,
        "Use case: Specify default or user‑defined joint positions, velocities, and efforts via parameters for quick configuration of robot pose"^^xsd:string ;
    ros:distribution "humble"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD"^^xsd:string ;
    ros:maintainer "Chris Lalancette <clalancette@osrfoundation.org>"^^xsd:string,
        "Shane Loretz <sloretz@osrfoundation.org>"^^xsd:string ;
    ros:optionallyDependsOn <http://www.ros.org/ontology#package/ament-copyright>,
        <http://www.ros.org/ontology#package/ament-flake8>,
        <http://www.ros.org/ontology#package/ament-pep257>,
        <http://www.ros.org/ontology#package/ament-xmllint>,
        <http://www.ros.org/ontology#package/launch-testing>,
        <http://www.ros.org/ontology#package/launch-testing-ros>,
        <http://www.ros.org/ontology#package/python3-pytest>,
        <http://www.ros.org/ontology#package/ros2topic> ;
    ros:packageName "joint_state_publisher"^^xsd:string ;
    ros:packageVersion "2.4.0"^^xsd:string ;
    ros:primaryFunction "Publish sensor_msgs/msg/JointState messages for a robot described by a URDF, providing default joint states and supporting mimic tags so that robot_state_publisher can generate valid transforms even without real encoder data."^^xsd:string ;
    ros:repositoryURL "https://github.com/ros/joint_state_publisher"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/python3-packaging>,
        <http://www.ros.org/ontology#package/rclpy>,
        <http://www.ros.org/ontology#package/sensor-msgs>,
        <http://www.ros.org/ontology#package/std-msgs> ;
    rdfs:comment """Package: joint_state_publisher | Description: 
    This package contains a tool for setting and publishing joint state values for a given URDF.
   | Function: Publish sensor_msgs/msg/JointState messages for a robot described by a URDF, providing default joint states and supporting mimic tags so that robot_state_publisher can generate valid transforms even without real encoder data. | Use Cases: Simulate joint states for a URDF robot during development or testing when actual joint sensors are not available, Provide /joint_states to robot_state_publisher in both simulation and real‑robot contexts to ensure valid transforms for all movable joints, Specify default or user‑defined joint positions, velocities, and efforts via parameters for quick configuration of robot pose, Handle mimic joint relationships and safety limits defined in the URDF without additional hardware | Performance: Publishes joint state messages at a configurable rate (default 10 Hz). The delta parameter allows incremental automatic joint movement per iteration, defaulting to 0.0. | Categories: control"""^^xsd:string,
        "Performance: Publishes joint state messages at a configurable rate (default 10 Hz). The delta parameter allows incremental automatic joint movement per iteration, defaulting to 0.0."^^xsd:string .

