    ros:licenseType "BSD"^^xsd:string ;
    ros:maintainer "AutonomouStuff Software Team <software@autonomoustuff.com>"^^xsd:string ;
    ros:packageName "avt_vimba_camera"^^xsd:string ;
    ros:packageVersion "1.2.0"^^xsd:string ;
