<http://www.ros.org/ontology#package/bond-core> a ros:ROSPackage ;
    rdfs:label "Bond Core"^^xsd:string ;
    dcterms:description """
    A bond allows two processes, A and B, to know when the other has
    terminated, either cleanly or by crashing. The bond remains
    connected until it is either broken explicitly or until a
    heartbeat times out.
  """^^xsd:string,
        "Use case: detecting process crashes"^^xsd:string,
        "Use case: ensuring graceful shutdown of interconnected nodes"^^xsd:string,
        "Use case: monitoring termination of paired processes"^^xsd:string ;
    ros:distribution "humble"^^xsd:string ;
    ros:implementsAlgorithm "heartbeat monitoring"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "BSD-3-Clause"^^xsd:string ;
    ros:maintainer "Geoffrey Biggs <geoff@openrobotics.org>"^^xsd:string ;
    ros:packageName "bond_core"^^xsd:string ;
    ros:packageVersion "4.1.2"^^xsd:string ;
    ros:primaryFunction "Provides a bonding mechanism between two processes to detect termination (clean or crash) and allow explicit bond breaking via heartbeat monitoring."^^xsd:string ;
    ros:repositoryURL "https://github.com/ros/bond_core"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/bond>,
        <http://www.ros.org/ontology#package/bondcpp>,
        <http://www.ros.org/ontology#package/smclib> ;
    rdfs:comment """Package: bond_core | Description: 
    A bond allows two processes, A and B, to know when the other has
    terminated, either cleanly or by crashing. The bond remains
    connected until it is either broken explicitly or until a
    heartbeat times out.
   | Function: Provides a bonding mechanism between two processes to detect termination (clean or crash) and allow explicit bond breaking via heartbeat monitoring. | Use Cases: monitoring termination of paired processes, detecting process crashes, ensuring graceful shutdown of interconnected nodes | Algorithms: heartbeat monitoring"""^^xsd:string .

