        <http://www.ros.org/ontology#package/std-srvs>,
        <http://www.ros.org/ontology#package/steering-controllers-library> ;
    ros:distribution "humble"^^xsd:string ;
    ros:implementsAlgorithm "Ackermann steering geometry"^^xsd:string ;
    ros:lastUpdated "2025-11-11"^^xsd:date ;
    ros:licenseType "Apache License 2.0"^^xsd:string ;
    ros:maintainer "Bence Magyar <bence.magyar.robotics@gmail.com>"^^xsd:string,
        "Christoph Froehlich <christoph.froehlich@ait.ac.at>"^^xsd:string,
        "Denis Štogl <denis@stoglrobotics.de>"^^xsd:string,
        "Sai Kishor Kothakota <sai.kishor@pal-robotics.com>"^^xsd:string ;
    ros:optionallyDependsOn <http://www.ros.org/ontology#package/ament-cmake-gmock>,
        <http://www.ros.org/ontology#package/controller-manager>,
        <http://www.ros.org/ontology#package/hardware-interface-testing>,
        <http://www.ros.org/ontology#package/ros2-control-test-assets> ;
    ros:packageName "ackermann_steering_controller"^^xsd:string ;
    ros:packageVersion "6.0.0"^^xsd:string ;
    ros:primaryFunction "Steering controller for Ackermann kinematics; controls the steering of the front wheels on vehicles with rear drive wheels."^^xsd:string ;
    ros:repositoryURL "https://github.com/ros-controls/ros2_controllers"^^xsd:anyURI ;
    ros:rosVersion "ROS 2"^^xsd:string ;
    ros:runtimeDependsOn <http://www.ros.org/ontology#package/backward-ros>,
        <http://www.ros.org/ontology#package/control-msgs>,
        <http://www.ros.org/ontology#package/controller-interface>,
        <http://www.ros.org/ontology#package/hardware-interface>,
        <http://www.ros.org/ontology#package/pluginlib>,
        <http://www.ros.org/ontology#package/rclcpp>,
        <http://www.ros.org/ontology#package/rclcpp-lifecycle>,
        <http://www.ros.org/ontology#package/std-srvs>,
        <http://www.ros.org/ontology#package/steering-controllers-library> ;
    rdfs:comment "Package: ackermann_steering_controller | Description: Steering controller for Ackermann kinematics. Rear fixed wheels are powering the vehicle and front wheels are steering it. | Function: Steering controller for Ackermann kinematics; controls the steering of the front wheels on vehicles with rear drive wheels. | Use Cases: Autonomous ground vehicle navigation, Robot car steering control, Simulation of Ackermann-steered vehicles | Algorithms: Ackermann steering geometry | Hardware Required: Steering joint hardware interface (velocity or position control) | Hardware Supported: Vehicles with front steering and rear drive wheels (Ackermann kinematics) | Categories: control"^^xsd:string .

