# data/components.ttl

# SPARQL query to INSERT all component data from the TTL file into the knowledge base.
# VERSION 4: Added top 10 railway inspection packages.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ros: <http://example.org/ros-ontology#>
PREFIX dcterms: <http://purl.org/dc/terms/>

INSERT DATA {
  # -- 1. Define all unique ROS Topic types found in the components --
  ros:topic_LaserScan             a ros:ROS_Topic ; rdfs:label "LaserScan Topic" ; ros:hasMessageType "sensor_msgs/LaserScan" .
  ros:topic_Odometry              a ros:ROS_Topic ; rdfs:label "Odometry Topic" ; ros:hasMessageType "geometry_msgs/Odometry" .
  ros:topic_PointCloud2           a ros:ROS_Topic ; rdfs:label "PointCloud2 Topic" ; ros:hasMessageType "sensor_msgs/PointCloud2" .
  ros:topic_PoseWithCovariance    a ros:ROS_Topic ; rdfs:label "PoseWithCovarianceStamped Topic" ; ros:hasMessageType "geometry_msgs/PoseWithCovarianceStamped" .
  ros:topic_OccupancyGrid         a ros:ROS_Topic ; rdfs:label "OccupancyGrid Topic" ; ros:hasMessageType "nav_msgs/OccupancyGrid" .
  ros:topic_Imu                   a ros:ROS_Topic ; rdfs:label "Imu Topic" ; ros:hasMessageType "sensor_msgs/Imu" .
  ros:topic_PoseStamped           a ros:ROS_Topic ; rdfs:label "PoseStamped Topic" ; ros:hasMessageType "geometry_msgs/PoseStamped" .
  ros:topic_Twist                 a ros:ROS_Topic ; rdfs:label "Twist Topic" ; ros:hasMessageType "geometry_msgs/Twist" .
  ros:topic_Path                  a ros:ROS_Topic ; rdfs:label "Path Topic" ; ros:hasMessageType "nav_msgs/Path" .
  ros:topic_JointState            a ros:ROS_Topic ; rdfs:label "JointState Topic" ; ros:hasMessageType "sensor_msgs/JointState" .
  ros:topic_Float64               a ros:ROS_Topic ; rdfs:label "Float64 Topic" ; ros:hasMessageType "std_msgs/Float64" .
  ros:topic_Image                 a ros:ROS_Topic ; rdfs:label "Image Topic" ; ros:hasMessageType "sensor_msgs/Image" .
  ros:topic_CameraInfo            a ros:ROS_Topic ; rdfs:label "CameraInfo Topic" ; ros:hasMessageType "sensor_msgs/CameraInfo" .
  ros:topic_Detection3DArray      a ros:ROS_Topic ; rdfs:label "Detection3DArray Topic" ; ros:hasMessageType "vision_msgs/Detection3DArray" .

  # -- 2. Define Localization Components --
  ros:amcl a ros:LocalizationComponent ;
    rdfs:label "AMCL" ;
    dcterms:description "Adaptive Monte Carlo Localization for a mobile robot. Uses particle filter to estimate robot pose." ;
    ros:isInPackage "amcl" ;
    ros:hasUpdateRate "10.0"^^xsd:float ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_LaserScan, ros:topic_Odometry, ros:topic_PointCloud2 ;
    ros:publishesTopic ros:topic_PoseWithCovariance, ros:topic_OccupancyGrid .

  ros:gmapping a ros:LocalizationComponent ;
    rdfs:label "GMapping" ;
    dcterms:description "Gmapping is a ROS wrapper for OpenSlam's GMapping. Creates 2D occupancy grid maps from laser data." ;
    ros:isInPackage "gmapping" ;
    ros:hasUpdateRate "5.0"^^xsd:float ;
    ros:implementsAlgorithm "slam" ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_LaserScan, ros:topic_Odometry ;
    ros:publishesTopic ros:topic_OccupancyGrid, ros:topic_PoseWithCovariance .

  # -- 3. Define Sensor Driver Components --
  ros:sick_scan_driver a ros:SensorDriverComponent ;
    rdfs:label "SICK Scan Driver" ;
    dcterms:description "Driver for SICK TIM series laser scanners. Provides laser scan data for navigation and mapping." ;
    ros:isInPackage "sick_scan" ;
    ros:hasUpdateRate "25.0"^^xsd:float ;
    ros:hasSensorType "laser_scanner" ;
    ros:rosVersion "ROS 2" ;
    ros:publishesTopic ros:topic_LaserScan .

  ros:velodyne_driver a ros:SensorDriverComponent ;
    rdfs:label "Velodyne Driver" ;
    dcterms:description "Driver for Velodyne 3D LiDAR scanners. Provides point cloud data for 3D perception." ;
    ros:isInPackage "velodyne_driver" ;
    ros:hasUpdateRate "10.0"^^xsd:float ;
    ros:hasSensorType "3d_lidar" ;
    ros:rosVersion "ROS 1" ;
    ros:publishesTopic ros:topic_PointCloud2 .

  ros:imu_driver a ros:SensorDriverComponent ;
    rdfs:label "IMU Driver" ;
    dcterms:description "Driver for Inertial Measurement Unit sensors. Provides orientation and angular velocity data." ;
    ros:isInPackage "imu_driver" ;
    ros:hasUpdateRate "100.0"^^xsd:float ;
    ros:hasSensorType "imu" ;
    ros:rosVersion "ROS 2" ;
    ros:publishesTopic ros:topic_Imu .

  # -- 4. Define Path Planning Components --
  ros:move_base a ros:PathPlannerComponent ;
    rdfs:label "Move Base" ;
    dcterms:description "Navigation stack for mobile robots. Combines global and local path planning with obstacle avoidance." ;
    ros:isInPackage "move_base" ;
    ros:hasUpdateRate "20.0"^^xsd:float ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_PoseStamped, ros:topic_LaserScan, ros:topic_OccupancyGrid ;
    ros:publishesTopic ros:topic_Twist, ros:topic_Path .

  ros:global_planner a ros:PathPlannerComponent ;
    rdfs:label "Global Planner" ;
    dcterms:description "Global path planning component. Calculates optimal path from current position to goal." ;
    ros:isInPackage "global_planner" ;
    ros:hasUpdateRate "1.0"^^xsd:float ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_PoseStamped, ros:topic_OccupancyGrid ;
    ros:publishesTopic ros:topic_Path .

  ros:local_planner a ros:PathPlannerComponent ;
    rdfs:label "Local Planner" ;
    dcterms:description "Local path planning and obstacle avoidance. Generates velocity commands for robot movement." ;
    ros:isInPackage "base_local_planner" ;
    ros:hasUpdateRate "20.0"^^xsd:float ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_Path, ros:topic_LaserScan, ros:topic_PoseStamped ;
    ros:publishesTopic ros:topic_Twist .

  # -- 5. Define Controller Components --
  ros:base_controller a ros:ControllerComponent ;
    rdfs:label "Base Controller" ;
    dcterms:description "Low-level controller for mobile robot base. Converts velocity commands to motor signals." ;
    ros:isInPackage "base_controller" ;
    ros:hasUpdateRate "50.0"^^xsd:float ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_Twist ;
    ros:publishesTopic ros:topic_JointState .

  ros:joint_controller a ros:ControllerComponent ;
    rdfs:label "Joint Controller" ;
    dcterms:description "Controller for individual robot joints. Manages position, velocity, and effort control." ;
    ros:isInPackage "joint_controller" ;
    ros:hasUpdateRate "100.0"^^xsd:float ;
    ros:rosVersion "ROS 2" ;
    ros:subscribesToTopic ros:topic_Float64 ;
    ros:publishesTopic ros:topic_JointState .

  # -- 6. Define Perception Components --
  ros:object_detection a ros:PerceptionComponent ;
    rdfs:label "Object Detection" ;
    dcterms:description "Computer vision-based object detection and recognition. Identifies objects in camera images." ;
    ros:isInPackage "object_detection" ;
    ros:hasUpdateRate "10.0"^^xsd:float ;
    ros:implementsAlgorithm "yolo" ;
    ros:rosVersion "ROS 2" ;
    ros:subscribesToTopic ros:topic_Image, ros:topic_CameraInfo ;
    ros:publishesTopic ros:topic_Detection3DArray .

  ros:point_cloud_processor a ros:PerceptionComponent ;
    rdfs:label "Point Cloud Processor" ;
    dcterms:description "Processes 3D point cloud data for filtering, segmentation, and feature extraction." ;
    ros:isInPackage "point_cloud_processor" ;
    ros:hasUpdateRate "10.0"^^xsd:float ;
    ros:implementsAlgorithm "pcl" ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_PointCloud2 ;
    ros:publishesTopic ros:topic_PointCloud2 .

  ros:slam_processor a ros:PerceptionComponent ;
    rdfs:label "SLAM Processor" ;
    dcterms:description "Simultaneous Localization and Mapping processor. Builds maps while localizing the robot." ;
    ros:isInPackage "slam_processor" ;
    ros:hasUpdateRate "5.0"^^xsd:float ;
    ros:implementsAlgorithm "graph_slam" ;
    ros:rosVersion "ROS 2" ;
    ros:subscribesToTopic ros:topic_LaserScan, ros:topic_PointCloud2, ros:topic_Odometry ;
    ros:publishesTopic ros:topic_OccupancyGrid, ros:topic_PoseWithCovariance .

  # -- 7. Additional Railway Inspection Components --
  ros:navigation2 a ros:PathPlannerComponent ;
    rdfs:label "Navigation2" ;
    dcterms:description "The ROS2 successor to the navigation stack. Nav2 provides perception, planning, and control modules (using behavior trees) for autonomous navigation." ;
    ros:isInPackage "navigation2" ;
    ros:rosVersion "ROS 2" ;
    ros:subscribesToTopic ros:topic_Odometry, ros:topic_LaserScan ;
    ros:publishesTopic ros:topic_Twist .

  ros:cartographer a ros:LocalizationComponent ;
    rdfs:label "Cartographer" ;
    dcterms:description "Google’s real-time SLAM library for 2D/3D mapping and localization. Takes input from LiDAR, IMU, odometry, etc., and produces consistent maps." ;
    ros:isInPackage "cartographer_ros" ;
    ros:rosVersion "ROS 1 & ROS 2" ;
    ros:subscribesToTopic ros:topic_LaserScan, ros:topic_PointCloud2, ros:topic_Imu, ros:topic_Odometry ;
    ros:publishesTopic ros:topic_OccupancyGrid, ros:topic_PoseWithCovariance .

  ros:pcl_ros a ros:PerceptionComponent ;
    rdfs:label "PCL ROS" ;
    dcterms:description "The ROS interface to the PCL library for 3D point-cloud processing. Includes tools to convert, filter, and segment LiDAR or depth-camera clouds." ;
    ros:isInPackage "pcl_ros" ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_PointCloud2 ;
    ros:publishesTopic ros:topic_PointCloud2 .

  ros:octomap_server a ros:PerceptionComponent ;
    rdfs:label "OctoMap Server" ;
    dcterms:description "A 3D occupancy-mapping system using octrees. The octomap_server node builds and publishes a volumetric map from point cloud input." ;
    ros:isInPackage "octomap_server" ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_PointCloud2 ;
    ros:publishesTopic ros:topic_OccupancyGrid .

  ros:moveit a ros:ManipulationComponent ;
    rdfs:label "MoveIt" ;
    dcterms:description "A motion-planning framework for robot manipulators. MoveIt provides kinematics, collision checking, and path planning for robot arms." ;
    ros:isInPackage "moveit" ;
    ros:rosVersion "ROS 1 & ROS 2" ;
    ros:subscribesToTopic ros:topic_JointState, ros:topic_PoseStamped ;
    ros:publishesTopic ros:topic_JointState .

  ros:gazebo a ros:SimulationComponent ;
    rdfs:label "Gazebo Simulator" ;
    dcterms:description "A high-fidelity physics simulator widely used with ROS. Gazebo can emulate realistic rail environments, vehicle dynamics, and sensors." ;
    ros:isInPackage "gazebo_ros_pkgs" ;
    ros:rosVersion "ROS 1 & ROS 2" .

  ros:ros_control a ros:ControllerComponent ;
    rdfs:label "ros_control" ;
    dcterms:description "A set of controller frameworks and hardware interfaces for actuator control. Standardizes how joint and sensor data are handled." ;
    ros:isInPackage "ros_control" ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_Twist, ros:topic_Float64 ;
    ros:publishesTopic ros:topic_JointState .
}
