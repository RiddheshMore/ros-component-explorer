# ROS Component Explorer - Structured Component Definitions
# Based on ROS Package Ontology Template
# Updated to follow comprehensive ontology framework

@prefix ros: <http://www.ros.org/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dep: <http://www.ros.org/dependency#> .
@prefix hw: <http://www.ros.org/hardware#> .
@prefix msg: <http://www.ros.org/message#> .

# =====================================
# HARDWARE COMPONENTS DEFINITIONS
# =====================================

# Sensor Hardware
hw:LaserScanner a hw:SensorHardware ;
    rdfs:label "Laser Scanner" ;
    rdfs:comment "2D/3D laser range finder" .

hw:Camera a hw:SensorHardware ;
    rdfs:label "Camera" ;
    rdfs:comment "Visual sensor for image capture" .

hw:IMU a hw:SensorHardware ;
    rdfs:label "Inertial Measurement Unit" ;
    rdfs:comment "Motion and orientation sensor" .

hw:GPS a hw:SensorHardware ;
    rdfs:label "GPS Receiver" ;
    rdfs:comment "Global positioning system receiver" .

hw:WheelEncoder a hw:SensorHardware ;
    rdfs:label "Wheel Encoder" ;
    rdfs:comment "Rotational position and velocity sensor" .

# Actuator Hardware  
hw:Motor a hw:ActuatorHardware ;
    rdfs:label "Motor" ;
    rdfs:comment "Electric motor for robot movement" .

hw:Servo a hw:ActuatorHardware ;
    rdfs:label "Servo Motor" ;
    rdfs:comment "Precision position-controlled motor" .

hw:Gripper a hw:ActuatorHardware ;
    rdfs:label "Robotic Gripper" ;
    rdfs:comment "End-effector for manipulation" .

# =====================================
# MESSAGE TYPE DEFINITIONS
# =====================================

msg:LaserScan a msg:SensorMessage ;
    rdfs:label "LaserScan Message" ;
    ros:hasMessageType "sensor_msgs/LaserScan" ;
    rdfs:comment "2D laser scan measurement data" .

msg:Odometry a msg:NavigationMessage ;
    rdfs:label "Odometry Message" ;
    ros:hasMessageType "nav_msgs/Odometry" ;
    rdfs:comment "Robot pose and velocity estimation" .

msg:PointCloud2 a msg:SensorMessage ;
    rdfs:label "PointCloud2 Message" ;
    ros:hasMessageType "sensor_msgs/PointCloud2" ;
    rdfs:comment "3D point cloud data" .

msg:PoseWithCovariance a msg:GeometryMessage ;
    rdfs:label "PoseWithCovarianceStamped Message" ;
    ros:hasMessageType "geometry_msgs/PoseWithCovarianceStamped" ;
    rdfs:comment "Robot pose with uncertainty estimation" .

msg:OccupancyGrid a msg:NavigationMessage ;
    rdfs:label "OccupancyGrid Message" ;
    ros:hasMessageType "nav_msgs/OccupancyGrid" ;
    rdfs:comment "2D occupancy grid map representation" .

msg:Imu a msg:SensorMessage ;
    rdfs:label "Imu Message" ;
    ros:hasMessageType "sensor_msgs/Imu" ;
    rdfs:comment "Inertial measurement unit data" .

msg:PoseStamped a msg:GeometryMessage ;
    rdfs:label "PoseStamped Message" ;
    ros:hasMessageType "geometry_msgs/PoseStamped" ;
    rdfs:comment "Timestamped pose information" .

msg:Twist a msg:ControlMessage ;
    rdfs:label "Twist Message" ;
    ros:hasMessageType "geometry_msgs/Twist" ;
    rdfs:comment "Linear and angular velocity commands" .

msg:Path a msg:NavigationMessage ;
    rdfs:label "Path Message" ;
    ros:hasMessageType "nav_msgs/Path" ;
    rdfs:comment "Sequence of poses forming a path" .
msg:JointState a msg:ControlMessage ;
    rdfs:label "JointState Message" ;
    ros:hasMessageType "sensor_msgs/JointState" ;
    rdfs:comment "Joint position and velocity data" .

msg:Float64 a msg:ControlMessage ;
    rdfs:label "Float64 Message" ;
    ros:hasMessageType "std_msgs/Float64" ;
    rdfs:comment "Single floating-point value" .

msg:Image a msg:SensorMessage ;
    rdfs:label "Image Message" ;
    ros:hasMessageType "sensor_msgs/Image" ;
    rdfs:comment "Camera image data" .

msg:CameraInfo a msg:SensorMessage ;
    rdfs:label "CameraInfo Message" ;
    ros:hasMessageType "sensor_msgs/CameraInfo" ;
    rdfs:comment "Camera calibration and metadata" .

msg:Detection3DArray a msg:SensorMessage ;
    rdfs:label "Detection3DArray Message" ;
    ros:hasMessageType "vision_msgs/Detection3DArray" ;
    rdfs:comment "Array of 3D object detections" .

# =====================================
# LOCALIZATION PACKAGES
# =====================================

# AMCL - Adaptive Monte Carlo Localization
ros:amcl a ros:LocalizationPackage ;
    rdfs:label "AMCL" ;
    dcterms:description "Adaptive Monte Carlo Localization for a mobile robot. Uses particle filter to estimate robot pose." ;
    
    # Core Properties
    ros:packageName "amcl" ;
    ros:packageVersion "2.1.0" ;
    ros:rosVersion "ROS 1" ;
    ros:maintainer "ROS Navigation Team" ;
    ros:licenseType "BSD-3-Clause" ;
    ros:repositoryURL <https://github.com/ros-planning/navigation> ;
    ros:lastUpdated "2024-03-15"^^xsd:date ;
    
    # Functional Properties
    ros:primaryFunction "Monte Carlo localization using particle filters" ;
    ros:implementsAlgorithm "Adaptive Monte Carlo Localization" ;
    ros:hasUpdateRate "10.0"^^xsd:float ;
    ros:hasLatency "50.0"^^xsd:float ;
    ros:hasAccuracy "0.90"^^xsd:float ;
    ros:hasComplexity "O(n)" ;
    
    # Hardware Requirements
    ros:requiresHardware hw:LaserScanner ;
    ros:supportsHardware hw:Camera ;
    ros:optionalHardware hw:WheelEncoder ;
    
    # Topic Interfaces
    ros:publishesTopic "amcl_pose", "particlecloud", "tf" ;
    ros:subscribesToTopic "scan", "tf", "initialpose", "map" ;
    
    # Platform Support
    ros:supportedPlatforms "turtlebot", "pr2", "generic_mobile_robot" ;
    ros:operatingSystem "Ubuntu 18.04", "Ubuntu 20.04" ;
    ros:architecture "x86_64", "aarch64" ;
    
    # Quality Metrics
    ros:maturityLevel "stable" ;
    ros:testCoverage "0.75"^^xsd:float ;
    ros:communityRating "4.3"^^xsd:float .

# GMapping - SLAM Package
ros:gmapping a ros:MappingPackage ;
    rdfs:label "GMapping" ;
    dcterms:description "Gmapping is a ROS wrapper for OpenSlam's GMapping. Creates 2D occupancy grid maps from laser data." ;
    
    # Core Properties
    ros:packageName "gmapping" ;
    ros:packageVersion "1.4.1" ;
    ros:rosVersion "ROS 1" ;
    ros:maintainer "ROS Navigation Team" ;
    ros:licenseType "BSD-3-Clause" ;
    ros:repositoryURL <https://github.com/ros-perception/slam_gmapping> ;
    ros:lastUpdated "2024-01-20"^^xsd:date ;
    
    # Functional Properties
    ros:primaryFunction "2D SLAM using Rao-Blackwellized particle filters" ;
    ros:implementsAlgorithm "Rao-Blackwellized Particle Filter SLAM" ;
    ros:hasUpdateRate "5.0"^^xsd:float ;
    ros:hasLatency "100.0"^^xsd:float ;
    ros:hasAccuracy "0.85"^^xsd:float ;
    ros:hasComplexity "O(n*log(n))" ;
    
    # Hardware Requirements
    ros:requiresHardware hw:LaserScanner ;
    ros:supportsHardware hw:WheelEncoder ;
    
    # Topic Interfaces
    ros:publishesTopic "map", "map_metadata", "tf" ;
    ros:subscribesToTopic "scan", "tf" ;
    
    # Platform Support
    ros:supportedPlatforms "turtlebot", "generic_mobile_robot" ;
    ros:operatingSystem "Ubuntu 18.04", "Ubuntu 20.04" ;
    ros:architecture "x86_64" ;
    
    # Dependencies
    ros:buildDependsOn ros:nav_msgs, ros:sensor_msgs, ros:tf ;
    ros:runtimeDependsOn ros:tf, ros:map_server ;
    
    # Quality Metrics
    ros:maturityLevel "stable" ;
    ros:testCoverage "0.60"^^xsd:float ;
    ros:communityRating "4.1"^^xsd:float .

# =====================================
# SENSOR DRIVER PACKAGES
# =====================================

# SICK Scan Driver - Laser Scanner
ros:sick_scan_driver a ros:SensorPackage ;
    rdfs:label "SICK Scan Driver" ;
    dcterms:description "Driver for SICK TIM series laser scanners. Provides laser scan data for navigation and mapping." ;
    
    # Core Properties
    ros:packageName "sick_scan" ;
    ros:packageVersion "1.7.3" ;
    ros:rosVersion "ROS 2" ;
    ros:maintainer "SICK AG" ;
    ros:licenseType "Apache-2.0" ;
    ros:repositoryURL <https://github.com/SICKAG/sick_scan_xd> ;
    ros:lastUpdated "2024-06-10"^^xsd:date ;
    
    # Functional Properties
    ros:primaryFunction "SICK laser scanner device driver" ;
    ros:implementsAlgorithm "SICK COLA protocol" ;
    ros:hasUpdateRate "25.0"^^xsd:float ;
    ros:hasLatency "40.0"^^xsd:float ;
    ros:hasAccuracy "0.99"^^xsd:float ;
    
    # Hardware Requirements
    ros:requiresHardware hw:LaserScanner ;
    
    # Topic Interfaces
    ros:publishesTopic "scan", "cloud" ;
    ros:providesService "sick_scan/ColaMsg" ;
    
    # Platform Support
    ros:supportedPlatforms "industrial_robots", "mobile_robots" ;
    ros:operatingSystem "Ubuntu 20.04", "Ubuntu 22.04", "Windows" ;
    ros:architecture "x86_64", "aarch64" ;
    
    # Quality Metrics
    ros:maturityLevel "stable" ;
    ros:testCoverage "0.80"^^xsd:float ;
    ros:communityRating "4.4"^^xsd:float .

# Velodyne Driver - 3D LiDAR
ros:velodyne_driver a ros:SensorPackage ;
    rdfs:label "Velodyne Driver" ;
    dcterms:description "Driver for Velodyne 3D LiDAR scanners. Provides point cloud data for 3D perception." ;
    
    # Core Properties
    ros:packageName "velodyne_pointcloud" ;
    ros:packageVersion "1.6.1" ;
    ros:rosVersion "ROS 1" ;
    ros:maintainer "Josh Whitley" ;
    ros:licenseType "BSD-3-Clause" ;
    ros:repositoryURL <https://github.com/ros-drivers/velodyne> ;
    ros:lastUpdated "2024-02-28"^^xsd:date ;
    
    # Functional Properties
    ros:primaryFunction "Velodyne 3D LiDAR data acquisition and processing" ;
    ros:implementsAlgorithm "UDP packet decoding and point cloud generation" ;
    ros:hasUpdateRate "10.0"^^xsd:float ;
    ros:hasLatency "100.0"^^xsd:float ;
    ros:hasAccuracy "0.95"^^xsd:float ;
    
    # Hardware Requirements
    ros:requiresHardware hw:LaserScanner ;
    
    # Topic Interfaces
    ros:publishesTopic "velodyne_points", "scan" ;
    
    # Platform Support
    ros:supportedPlatforms "autonomous_vehicles", "mobile_robots", "industrial" ;
    ros:operatingSystem "Ubuntu 18.04", "Ubuntu 20.04" ;
    ros:architecture "x86_64" ;
    
    # Quality Metrics
    ros:maturityLevel "stable" ;
    ros:testCoverage "0.70"^^xsd:float ;
    ros:communityRating "4.2"^^xsd:float .

# =====================================
# NAVIGATION PACKAGES
# =====================================

# Move Base - Navigation Framework
ros:move_base a ros:NavigationPackage ;
    rdfs:label "Move Base" ;
    dcterms:description "Complete navigation framework providing goal-directed motion for mobile robots with global and local path planning." ;
    
    # Core Properties
    ros:packageName "move_base" ;
    ros:packageVersion "1.17.1" ;
    ros:rosVersion "ROS 1" ;
    ros:maintainer "ROS Navigation Team" ;
    ros:licenseType "BSD-3-Clause" ;
    ros:repositoryURL <https://github.com/ros-planning/navigation> ;
    ros:lastUpdated "2024-04-12"^^xsd:date ;
    
    # Functional Properties
    ros:primaryFunction "Complete navigation stack integration" ;
    ros:implementsAlgorithm "Action server based navigation" ;
    ros:hasUpdateRate "20.0"^^xsd:float ;
    ros:hasLatency "200.0"^^xsd:float ;
    ros:hasAccuracy "0.88"^^xsd:float ;
    ros:hasComplexity "O(n^2)" ;
    
    # Hardware Requirements
    ros:requiresHardware hw:LaserScanner, hw:WheelEncoder ;
    ros:supportsHardware hw:IMU, hw:Camera ;
    
    # Topic Interfaces
    ros:publishesTopic "cmd_vel", "move_base/feedback", "move_base/result", "move_base/global_costmap/costmap" ;
    ros:subscribesToTopic "move_base_simple/goal", "scan", "odom", "map", "tf" ;
    ros:providesService "move_base/make_plan", "move_base/clear_costmaps" ;
    
    # Platform Support
    ros:supportedPlatforms "turtlebot", "pr2", "husky", "jackal" ;
    ros:operatingSystem "Ubuntu 18.04", "Ubuntu 20.04" ;
    ros:architecture "x86_64", "armhf" ;
    
    # Dependencies
    ros:buildDependsOn ros:actionlib, ros:geometry_msgs, ros:nav_msgs ;
    ros:runtimeDependsOn ros:tf, ros:map_server, ros:amcl ;
    ros:typicallyUsedWith ros:amcl, ros:map_server ;
    ros:compatibleWith ros:gmapping ;
    
    # Quality Metrics
    ros:maturityLevel "stable" ;
    ros:testCoverage "0.65"^^xsd:float ;
    ros:communityRating "4.0"^^xsd:float .

# =====================================
# PERCEPTION PACKAGES
# =====================================

# OpenCV Bridge - Image Processing Interface
ros:cv_bridge a ros:PerceptionPackage ;
    rdfs:label "CV Bridge" ;
    dcterms:description "ROS interface for OpenCV image processing. Converts between ROS Image messages and OpenCV matrices." ;
    
    # Core Properties
    ros:packageName "cv_bridge" ;
    ros:packageVersion "1.16.2" ;
    ros:rosVersion "ROS 1/2" ;
    ros:maintainer "ROS Vision Team" ;
    ros:licenseType "BSD-3-Clause" ;
    ros:repositoryURL <https://github.com/ros-perception/vision_opencv> ;
    ros:lastUpdated "2024-05-20"^^xsd:date ;
    
    # Functional Properties
    ros:primaryFunction "ROS-OpenCV image conversion and processing utilities" ;
    ros:implementsAlgorithm "Image format conversion and basic processing" ;
    ros:hasUpdateRate "30.0"^^xsd:float ;
    ros:hasLatency "10.0"^^xsd:float ;
    ros:hasAccuracy "1.0"^^xsd:float ;
    ros:hasComplexity "O(n)" ;
    
    # Hardware Requirements
    ros:requiresHardware hw:Camera ;
    
    # Topic Interfaces
    ros:publishesTopic "image_processed", "camera_info" ;
    ros:subscribesToTopic "image_raw", "camera_info" ;
    
    # Platform Support
    ros:supportedPlatforms "universal" ;
    ros:operatingSystem "Ubuntu 18.04", "Ubuntu 20.04", "Ubuntu 22.04", "Windows", "macOS" ;
    ros:architecture "x86_64", "aarch64", "armhf" ;
    
    # Dependencies
    ros:buildDependsOn ros:sensor_msgs, ros:opencv ;
    ros:runtimeDependsOn ros:opencv ;
    ros:complementedBy ros:image_transport ;
    
    # Quality Metrics
    ros:maturityLevel "stable" ;
    ros:testCoverage "0.90"^^xsd:float ;
    ros:communityRating "4.6"^^xsd:float .

  # -- 2. Define Sensor Components --
  # NOTE: Duplicate velodyne_driver removed - already defined above as ros:SensorPackage

  # IMU Driver removed - auto-generated packages below already define IMU-related packages

  # -- 4. Define Path Planning Components --
  # NOTE: Duplicate move_base removed - already defined above as ros:NavigationPackage

  ros:global_planner a ros:NavigationPackage ;
    rdfs:label "Global Planner" ;
    dcterms:description "Global path planning component. Calculates optimal path from current position to goal." ;
    ros:isInPackage "global_planner" ;
    ros:hasUpdateRate "1.0"^^xsd:float ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_PoseStamped, ros:topic_OccupancyGrid ;
    ros:publishesTopic ros:topic_Path .

  ros:local_planner a ros:NavigationPackage ;
    rdfs:label "Local Planner" ;
    dcterms:description "Local path planning and obstacle avoidance. Generates velocity commands for robot movement." ;
    ros:isInPackage "base_local_planner" ;
    ros:hasUpdateRate "20.0"^^xsd:float ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_Path, ros:topic_LaserScan, ros:topic_PoseStamped ;
    ros:publishesTopic ros:topic_Twist .

  # -- 5. Define Controller Components --
  ros:base_controller a ros:ControlPackage ;
    rdfs:label "Base Controller" ;
    dcterms:description "Low-level controller for mobile robot base. Converts velocity commands to motor signals." ;
    ros:isInPackage "base_controller" ;
    ros:hasUpdateRate "50.0"^^xsd:float ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_Twist ;
    ros:publishesTopic ros:topic_JointState .

  ros:joint_controller a ros:ControlPackage ;
    rdfs:label "Joint Controller" ;
    dcterms:description "Controller for individual robot joints. Manages position, velocity, and effort control." ;
    ros:isInPackage "joint_controller" ;
    ros:hasUpdateRate "100.0"^^xsd:float ;
    ros:rosVersion "ROS 2" ;
    ros:subscribesToTopic ros:topic_Float64 ;
    ros:publishesTopic ros:topic_JointState .

  # -- 6. Define Perception Components --
  ros:object_detection a ros:PerceptionPackage ;
    rdfs:label "Object Detection" ;
    dcterms:description "Computer vision-based object detection and recognition. Identifies objects in camera images." ;
    ros:isInPackage "object_detection" ;
    ros:hasUpdateRate "10.0"^^xsd:float ;
    ros:implementsAlgorithm "yolo" ;
    ros:rosVersion "ROS 2" ;
    ros:subscribesToTopic ros:topic_Image, ros:topic_CameraInfo ;
    ros:publishesTopic ros:topic_Detection3DArray .

  ros:point_cloud_processor a ros:PerceptionPackage ;
    rdfs:label "Point Cloud Processor" ;
    dcterms:description "Processes 3D point cloud data for filtering, segmentation, and feature extraction." ;
    ros:isInPackage "point_cloud_processor" ;
    ros:hasUpdateRate "10.0"^^xsd:float ;
    ros:implementsAlgorithm "pcl" ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_PointCloud2 ;
    ros:publishesTopic ros:topic_PointCloud2 .

  ros:slam_processor a ros:MappingPackage ;
    rdfs:label "SLAM Processor" ;
    dcterms:description "Simultaneous Localization and Mapping processor. Builds maps while localizing the robot." ;
    ros:isInPackage "slam_processor" ;
    ros:hasUpdateRate "5.0"^^xsd:float ;
    ros:implementsAlgorithm "graph_slam" ;
    ros:rosVersion "ROS 2" ;
    ros:subscribesToTopic ros:topic_LaserScan, ros:topic_PointCloud2, ros:topic_Odometry ;
    ros:publishesTopic ros:topic_OccupancyGrid, ros:topic_PoseWithCovariance .

  # -- 7. Additional Railway Inspection Components --
  ros:navigation2 a ros:NavigationPackage ;
    rdfs:label "Navigation2" ;
    dcterms:description "The ROS2 successor to the navigation stack. Nav2 provides perception, planning, and control modules (using behavior trees) for autonomous navigation." ;
    ros:isInPackage "navigation2" ;
    ros:rosVersion "ROS 2" ;
    ros:subscribesToTopic ros:topic_Odometry, ros:topic_LaserScan ;
    ros:publishesTopic ros:topic_Twist .

  ros:cartographer a ros:LocalizationPackage ;
    rdfs:label "Cartographer" ;
    dcterms:description "Google’s real-time SLAM library for 2D/3D mapping and localization. Takes input from LiDAR, IMU, odometry, etc., and produces consistent maps." ;
    ros:isInPackage "cartographer_ros" ;
    ros:rosVersion "ROS 1 & ROS 2" ;
    ros:subscribesToTopic ros:topic_LaserScan, ros:topic_PointCloud2, ros:topic_Imu, ros:topic_Odometry ;
    ros:publishesTopic ros:topic_OccupancyGrid, ros:topic_PoseWithCovariance .

  ros:pcl_ros a ros:PerceptionPackage ;
    rdfs:label "PCL ROS" ;
    dcterms:description "The ROS interface to the PCL library for 3D point-cloud processing. Includes tools to convert, filter, and segment LiDAR or depth-camera clouds." ;
    ros:isInPackage "pcl_ros" ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_PointCloud2 ;
    ros:publishesTopic ros:topic_PointCloud2 .

  ros:octomap_server a ros:PerceptionPackage ;
    rdfs:label "OctoMap Server" ;
    dcterms:description "A 3D occupancy-mapping system using octrees. The octomap_server node builds and publishes a volumetric map from point cloud input." ;
    ros:isInPackage "octomap_server" ;
    ros:rosVersion "ROS 1" ;
    ros:subscribesToTopic ros:topic_PointCloud2 ;
    ros:publishesTopic ros:topic_OccupancyGrid .

  ros:moveit a ros:ManipulationPackage ;
    rdfs:label "MoveIt" ;
    dcterms:description "A motion-planning framework for robot manipulators. MoveIt provides kinematics, collision checking, and path planning for robot arms." ;
    ros:isInPackage "moveit" ;
    ros:rosVersion "ROS 1 & ROS 2" ;
    ros:subscribesToTopic ros:topic_JointState, ros:topic_PoseStamped ;
    ros:publishesTopic ros:topic_JointState .

# =====================================
# SIMULATION PACKAGES
# =====================================

# Gazebo - Physics-based Robot Simulator
  ros:gazebo a ros:SimulationPackage ;
    rdfs:label "Gazebo Simulator" ;
    dcterms:description "A high-fidelity physics simulator widely used with ROS. Gazebo can emulate realistic rail environments, vehicle dynamics, and sensors. Supports multiple physics engines (ODE, Bullet, Simbody, DART)." ;
    
    # Core Properties
    ros:packageName "gazebo_ros_pkgs" ;
    ros:isInPackage "gazebo_ros_pkgs" ;
    ros:rosVersion "ROS 1 & ROS 2" ;
    ros:maintainer "Open Source Robotics Foundation" ;
    ros:licenseType "Apache-2.0" ;
    ros:repositoryURL <https://github.com/ros-simulation/gazebo_ros_pkgs> ;
    
    # Simulation Properties
    ros:simulationEngine "Gazebo Classic" ;
    ros:physicsEngine "ODE, Bullet, Simbody, DART" ;
    ros:hasRenderingEngine "OGRE" ;
    ros:supports3DVisualization "true"^^xsd:boolean ;
    ros:supportsSensorSimulation "true"^^xsd:boolean ;
    ros:supportsPhysicsSimulation "true"^^xsd:boolean .

# Ignition Gazebo - Next-Generation Simulator
  ros:ignition_gazebo a ros:SimulationPackage ;
    rdfs:label "Ignition Gazebo" ;
    dcterms:description "Next-generation robot simulator (now called Gazebo) designed for ROS 2. Features improved performance, modularity, and distributed simulation capabilities." ;
    
    # Core Properties
    ros:packageName "ros_gz_sim" ;
    ros:isInPackage "ros_gz" ;
    ros:rosVersion "ROS 2" ;
    ros:maintainer "Open Source Robotics Foundation" ;
    ros:licenseType "Apache-2.0" ;
    ros:repositoryURL <https://github.com/gazebosim/ros_gz> ;
    
    # Simulation Properties
    ros:simulationEngine "Ignition Gazebo (Gazebo Sim)" ;
    ros:physicsEngine "DART, TPE" ;
    ros:hasRenderingEngine "Ignition Rendering (OGRE2)" ;
    ros:supports3DVisualization "true"^^xsd:boolean ;
    ros:supportsSensorSimulation "true"^^xsd:boolean ;
    ros:supportsPhysicsSimulation "true"^^xsd:boolean ;
    
    # Dependencies
    ros:buildDependsOn "ros_gz_bridge", "ros_gz_image" ;
    ros:runtimeDependsOn "gz-sim", "gz-transport" .

# Webots - Open Source Robot Simulator
  ros:webots_ros2 a ros:SimulationPackage ;
    rdfs:label "Webots ROS 2" ;
    dcterms:description "ROS 2 interface for Webots robot simulator. Webots provides a fast prototyping environment with realistic physics and sensors for mobile robots, manipulators, and wheeled vehicles." ;
    
    # Core Properties
    ros:packageName "webots_ros2" ;
    ros:isInPackage "webots_ros2" ;
    ros:rosVersion "ROS 2" ;
    ros:maintainer "Cyberbotics Ltd." ;
    ros:licenseType "Apache-2.0" ;
    ros:repositoryURL <https://github.com/cyberbotics/webots_ros2> ;
    
    # Simulation Properties
    ros:simulationEngine "Webots" ;
    ros:physicsEngine "ODE" ;
    ros:hasRenderingEngine "OpenGL" ;
    ros:supports3DVisualization "true"^^xsd:boolean ;
    ros:supportsSensorSimulation "true"^^xsd:boolean ;
    ros:supportsPhysicsSimulation "true"^^xsd:boolean ;
    
    # Topics
    ros:subscribesToTopic ros:topic_Twist ;
    ros:publishesTopic ros:topic_Odometry, ros:topic_LaserScan, ros:topic_Image ;
    
    # Dependencies
    ros:buildDependsOn "rclcpp", "std_msgs", "sensor_msgs" ;
    ros:runtimeDependsOn "webots" .

# CoppeliaSim (V-REP) - Robot Simulator
  ros:coppeliasim_ros2 a ros:SimulationPackage ;
    rdfs:label "CoppeliaSim ROS 2 Interface" ;
    dcterms:description "ROS 2 interface for CoppeliaSim (formerly V-REP) robot simulator. Offers integrated development environment with extensive APIs, multiple physics engines, and comprehensive sensor simulation." ;
    
    # Core Properties
    ros:packageName "coppeliasim_ros2_interface" ;
    ros:isInPackage "coppeliasim_ros2_interface" ;
    ros:rosVersion "ROS 2" ;
    ros:maintainer "Coppelia Robotics" ;
    ros:licenseType "GPL-3.0" ;
    ros:repositoryURL <https://github.com/CoppeliaRobotics/ros2_coppeliasim_interface> ;
    
    # Simulation Properties
    ros:simulationEngine "CoppeliaSim" ;
    ros:physicsEngine "Bullet, ODE, Vortex, Newton" ;
    ros:hasRenderingEngine "OpenGL" ;
    ros:supports3DVisualization "true"^^xsd:boolean ;
    ros:supportsSensorSimulation "true"^^xsd:boolean ;
    ros:supportsPhysicsSimulation "true"^^xsd:boolean ;
    
    # Topics
    ros:subscribesToTopic ros:topic_Twist ;
    ros:publishesTopic ros:topic_JointState, ros:topic_Image, ros:topic_LaserScan ;
    
    # Dependencies
    ros:buildDependsOn "rclcpp", "geometry_msgs", "sensor_msgs" ;
    ros:runtimeDependsOn "coppeliasim" .

# Unity Robotics Hub - Game Engine Based Simulation
  ros:unity_robotics a ros:SimulationPackage ;
    rdfs:label "Unity Robotics Hub" ;
    dcterms:description "Unity-based robotics simulation framework with ROS integration. Leverages Unity's powerful rendering, physics (PhysX), and machine learning capabilities for robot development and training." ;
    
    # Core Properties
    ros:packageName "unity_robotics_demo" ;
    ros:isInPackage "ROS-TCP-Connector" ;
    ros:rosVersion "ROS 1 & ROS 2" ;
    ros:maintainer "Unity Technologies" ;
    ros:licenseType "Apache-2.0" ;
    ros:repositoryURL <https://github.com/Unity-Technologies/Unity-Robotics-Hub> ;
    
    # Simulation Properties
    ros:simulationEngine "Unity" ;
    ros:physicsEngine "PhysX, Articulation Body" ;
    ros:hasRenderingEngine "Unity Universal Render Pipeline" ;
    ros:supports3DVisualization "true"^^xsd:boolean ;
    ros:supportsSensorSimulation "true"^^xsd:boolean ;
    ros:supportsPhysicsSimulation "true"^^xsd:boolean ;
    
    # Topics
    ros:subscribesToTopic ros:topic_Twist ;
    ros:publishesTopic ros:topic_Image, ros:topic_Odometry, ros:topic_JointState ;
    
    # Dependencies
    ros:buildDependsOn "rospy", "geometry_msgs" ;
    ros:runtimeDependsOn "ros_tcp_endpoint" .

# NVIDIA Isaac Sim - High-Fidelity Robotics Simulator
  ros:isaac_sim a ros:SimulationPackage ;
    rdfs:label "NVIDIA Isaac Sim" ;
    dcterms:description "NVIDIA's physically accurate, photorealistic robotics simulator built on Omniverse. Features RTX ray tracing, PhysX 5, synthetic data generation, and domain randomization for AI training." ;
    
    # Core Properties
    ros:packageName "isaac_ros_simulation" ;
    ros:isInPackage "isaac_ros_common" ;
    ros:rosVersion "ROS 2" ;
    ros:maintainer "NVIDIA Corporation" ;
    ros:licenseType "NVIDIA Omniverse License" ;
    ros:repositoryURL <https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_common> ;
    
    # Simulation Properties
    ros:simulationEngine "Isaac Sim (Omniverse)" ;
    ros:physicsEngine "PhysX 5" ;
    ros:hasRenderingEngine "RTX Ray Tracing (Omniverse)" ;
    ros:supports3DVisualization "true"^^xsd:boolean ;
    ros:supportsSensorSimulation "true"^^xsd:boolean ;
    ros:supportsPhysicsSimulation "true"^^xsd:boolean ;
    
    # Topics
    ros:subscribesToTopic ros:topic_Twist ;
    ros:publishesTopic ros:topic_Image, ros:topic_CameraInfo, ros:topic_PointCloud2, ros:topic_LaserScan ;
    
    # Dependencies
    ros:buildDependsOn "rclcpp", "sensor_msgs", "nav_msgs" ;
    ros:runtimeDependsOn "isaac_sim_core" .

# Stage - 2D Multi-Robot Simulator
  ros:stage_ros a ros:SimulationPackage ;
    rdfs:label "Stage ROS" ;
    dcterms:description "Lightweight 2D multi-robot simulator for ROS. Efficient for testing navigation algorithms with large numbers of robots in 2D environments." ;
    
    # Core Properties
    ros:packageName "stage_ros" ;
    ros:isInPackage "stage_ros" ;
    ros:rosVersion "ROS 1" ;
    ros:maintainer "ROS Community" ;
    ros:licenseType "GPL-2.0" ;
    ros:repositoryURL <https://github.com/ros-simulation/stage_ros> ;
    
    # Simulation Properties
    ros:simulationEngine "Stage" ;
    ros:physicsEngine "2D Kinematic" ;
    ros:hasRenderingEngine "FLTK" ;
    ros:supports3DVisualization "false"^^xsd:boolean ;
    ros:supportsSensorSimulation "true"^^xsd:boolean ;
    ros:supportsPhysicsSimulation "true"^^xsd:boolean ;
    
    # Topics
    ros:subscribesToTopic ros:topic_Twist ;
    ros:publishesTopic ros:topic_Odometry, ros:topic_LaserScan ;
    
    # Dependencies
    ros:buildDependsOn "roscpp", "nav_msgs", "sensor_msgs" ;
    ros:runtimeDependsOn "stage" .

