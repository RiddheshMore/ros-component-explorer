# data/expanded_components.ttl
# Expanded Knowledge Base with Additional ROS Packages
# This file contains new components across Localization, Sensor Drivers, Path Planning, and Perception categories

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix comp: <http://example.org/ros-components#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# -- Additional ROS Topic types for new components --
comp:topic_NavSatFix             a comp:ROS_Topic ; rdfs:label "NavSatFix Topic" ; comp:hasMessageType "sensor_msgs/NavSatFix" .
comp:topic_DepthImage            a comp:ROS_Topic ; rdfs:label "DepthImage Topic" ; comp:hasMessageType "sensor_msgs/Image" .
comp:topic_CompressedImage       a comp:ROS_Topic ; rdfs:label "CompressedImage Topic" ; comp:hasMessageType "sensor_msgs/CompressedImage" .
comp:topic_AprilTagDetectionArray a comp:ROS_Topic ; rdfs:label "AprilTagDetectionArray Topic" ; comp:hasMessageType "apriltag_ros/AprilTagDetectionArray" .
comp:topic_BoundingBoxes         a comp:ROS_Topic ; rdfs:label "BoundingBoxes Topic" ; comp:hasMessageType "darknet_ros_msgs/BoundingBoxes" .
comp:topic_ObjectCount           a comp:ROS_Topic ; rdfs:label "ObjectCount Topic" ; comp:hasMessageType "darknet_ros_msgs/ObjectCount" .
comp:topic_TemperatureMsg        a comp:ROS_Topic ; rdfs:label "Temperature Topic" ; comp:hasMessageType "sensor_msgs/Temperature" .

  # -- LOCALIZATION COMPONENTS --

  # Robot Localization
  comp:robot_localization a comp:LocalizationNode ;
    rdfs:label "robot_localization" ;
    comp:description "A collection of state estimation nodes for ROS that provides sensor fusion for localization and mapping. Includes Extended Kalman Filter (EKF) and Unscented Kalman Filter (UKF) implementations." ;
    comp:package "robot_localization" ;
    comp:updateRate "30.0"^^xsd:float ;
    comp:rosVersion "ROS 1 & ROS 2" ;
    comp:hasInput "imu/data", "odom", "gps/fix", "pose" ;
    comp:hasOutput "odometry/filtered", "pose/filtered" .

  # Hector SLAM
  comp:hector_slam a comp:LocalizationNode ;
    rdfs:label "Hector SLAM" ;
    comp:description "A flexible and scalable SLAM approach that does not require odometry. Uses high update rate 2D range scan matching and provides 2D pose estimates at scan rate." ;
    comp:package "hector_slam" ;
    comp:updateRate "40.0"^^xsd:float ;
    comp:rosVersion "ROS 1" ;
    comp:hasInput "scan" ;
    comp:hasOutput "map", "pose" .

  # ORB-SLAM2
  comp:orb_slam2 a comp:LocalizationNode ;
    rdfs:label "ORB_SLAM2" ;
    comp:description "A real-time SLAM library for monocular, stereo and RGB-D cameras that computes the camera trajectory and a sparse 3D reconstruction in real-time." ;
    comp:package "orb_slam2_ros" ;
    comp:updateRate "30.0"^^xsd:float ;
    comp:rosVersion "ROS 1" ;
    comp:hasInput "camera/image_raw", "camera/camera_info", "camera/depth/image_raw" ;
    comp:hasOutput "pose", "pointcloud" .

  # -- SENSOR DRIVER COMPONENTS --

  # Intel RealSense
  comp:realsense_ros a comp:SensorDriver ;
    rdfs:label "realsense-ros" ;
    comp:description "ROS drivers for Intel RealSense cameras including D400, L500, and T265 series. Provides RGB, depth, and IMU data streams with configurable parameters." ;
    comp:package "realsense2_camera" ;
    comp:updateRate "30.0"^^xsd:float ;
    comp:rosVersion "ROS 1 & ROS 2" ;
    comp:hasOutput "color/image_raw", "depth/image_rect_raw", "camera_info", "imu", "points" .

  # FLIR Camera Driver
  comp:flir_camera_driver a comp:SensorDriver ;
    rdfs:label "flir_camera_driver" ;
    comp:description "ROS driver for FLIR thermal and visible cameras using the Spinnaker SDK. Supports various FLIR camera models with configurable exposure, gain, and frame rate settings." ;
    comp:package "flir_camera_driver" ;
    comp:updateRate "30.0"^^xsd:float ;
    comp:rosVersion "ROS 1 & ROS 2" ;
    comp:hasOutput "image_raw", "camera_info", "image_raw/compressed", "temperature" .

  # u-blox GPS Driver
  comp:ublox_gps a comp:SensorDriver ;
    rdfs:label "ublox_gps" ;
    comp:description "ROS driver for u-blox GPS receivers. Provides GNSS positioning data, supports RTK corrections, and includes configuration utilities for various u-blox modules." ;
    comp:package "ublox_gps" ;
    comp:updateRate "10.0"^^xsd:float ;
    comp:rosVersion "ROS 1 & ROS 2" ;
    comp:hasOutput "fix", "navsat" .

  # -- PATH PLANNING COMPONENTS --

  # TEB Local Planner
  comp:teb_local_planner a comp:PathPlanner ;
    rdfs:label "TEB Local Planner" ;
    comp:description "A local trajectory planner that optimizes the robot's trajectory with respect to trajectory execution time, separation from obstacles, and compliance with kinodynamic constraints." ;
    comp:package "teb_local_planner" ;
    comp:updateRate "10.0"^^xsd:float ;
    comp:rosVersion "ROS 1" ;
    comp:hasInput "scan", "map", "odom", "goal" ;
    comp:hasOutput "cmd_vel", "local_plan" .

  # SMAC Planner
  comp:smac_planner a comp:PathPlanner ;
    rdfs:label "Smac Planner" ;
    comp:description "A hybrid A* planner for Nav2 that creates kinematically feasible paths for differential drive and car-like robots. Supports lattice-based and hybrid approaches." ;
    comp:package "nav2_smac_planner" ;
    comp:updateRate "1.0"^^xsd:float ;
    comp:rosVersion "ROS 2" ;
    comp:hasInput "costmap", "start", "goal" ;
    comp:hasOutput "path" .

  # RRT* Planner
  comp:rrt_star_planner a comp:PathPlanner ;
    rdfs:label "RRT* Planner" ;
    comp:description "An asymptotically optimal rapidly-exploring random tree planner. Provides probabilistically complete and asymptotically optimal path planning in complex environments." ;
    comp:package "rrt_star_planner" ;
    comp:updateRate "2.0"^^xsd:float ;
    comp:rosVersion "ROS 1 & ROS 2" ;
    comp:hasInput "costmap", "start", "goal" ;
    comp:hasOutput "path" .

  # -- PERCEPTION COMPONENTS --

  # YOLO with darknet_ros
  comp:darknet_ros a comp:PerceptionNode ;
    rdfs:label "darknet_ros (YOLO)" ;
    comp:description "Real-time object detection using YOLO (You Only Look Once) neural networks. Detects multiple object classes in images with bounding boxes and confidence scores." ;
    comp:package "darknet_ros" ;
    comp:updateRate "30.0"^^xsd:float ;
    comp:rosVersion "ROS 1" ;
    comp:hasInput "camera/image_raw" ;
    comp:hasOutput "bounding_boxes", "detection_image", "object_detector/detected_objects" .

  # AprilTag Detection
  comp:apriltag_ros a comp:PerceptionNode ;
    rdfs:label "apriltag_ros" ;
    comp:description "A ROS wrapper for the AprilTag visual fiducial detection system. Detects AprilTag markers in images and provides their 6DOF poses for localization and navigation." ;
    comp:package "apriltag_ros" ;
    comp:updateRate "30.0"^^xsd:float ;
    comp:rosVersion "ROS 1 & ROS 2" ;
    comp:hasInput "image_rect", "camera_info" ;
    comp:hasOutput "tag_detections", "tag_detections_image" .

  # Laser Filters
  comp:laser_filters a comp:PerceptionNode ;
    rdfs:label "laser_filters" ;
    comp:description "A collection of filters for processing laser scan data. Includes filters for removing spurious readings, angular bounds, intensity filtering, and temporal smoothing." ;
    comp:package "laser_filters" ;
    comp:updateRate "40.0"^^xsd:float ;
    comp:rosVersion "ROS 1 & ROS 2" ;
    comp:hasInput "scan_raw" ;
    comp:hasOutput "scan_filtered" .
